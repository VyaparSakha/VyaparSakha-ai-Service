# Gemini (main reasoning LLM). Free tier is capped at 20 req/day per model,
# so the agent falls back to other providers automatically when quota is hit.
GEMINI_API_KEY=

# MongoDB (LangGraph checkpointer + app data)
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=vyapar-sathi
LANGCHAIN_CHECKPOINTER_TTL_SECONDS=604800

# LangChain tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=vyaparSathi-ai
LANGCHAIN_VERBOSE=true
LANGCHAIN_TRACING_V2=true

# Mem0 long-term memory (optional)
MEM0_API_KEY=
MEM0_ENABLED=true

# LLM fallback chain (OpenAI-compatible endpoints).
# Order: gemini-2.5-flash -> gemini-2.5-flash-lite -> NVIDIA -> GROQ.
# The agent tries the next provider when the current one returns 429
# (rate limit) or any other error. Set any subset; the chain only
# includes providers with a key configured.
GROQ_API_KEY=
NVIDIA_API_KEY=

# Web search / scraping
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_SECONDS=60

# Cloudflare Workers AI (GLM & Gemma models)
CLOUDFLARE_AI_ACCOUNT_ID=your_ai_account_id
CLOUDFLARE_AI_API_TOKEN=your_ai_api_token
CLOUDFLARE_AI_MODEL=glm
AI_ENABLE_FALLBACK=true
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.4

# Cloudflare R2 object storage (backend only - distinct account supported)
CLOUDFLARE_R2_ACCOUNT_ID=your_r2_account_id
CLOUDFLARE_R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name
